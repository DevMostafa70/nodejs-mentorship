{
  "name": "motqdmon-aid-news-api",
  "version": "2.0.0",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "scrape": "node -e \"require('./src/services/scraper.service').runScrapeOnce({maxPages:Number(process.env.MAX_PAGES||10)}).then(r=>{console.log(r);process.exit(0)}).catch(e=>{console.error(e);process.exit(1)})\"",
    "logs": "tail -f logs/combined.log",
    "logs:error": "tail -f logs/error.log"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "knex": "^3.1.0",
    "puppeteer": "^24.0.0",
    "sqlite3": "^5.1.7",
    "winston": "^3.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}