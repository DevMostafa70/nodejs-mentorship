PORT=3000
DATABASE_FILE=./data.sqlite

# صفحة "المساعدات" في موقع المتقدمون (حسب وصف مشروع المساق)
BASE_URL=https://www.motqdmon.com/search/label/%D8%A7%D9%84%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A7%D8%AA

# تشغيل scraping تلقائياً عند تشغيل السيرفر
SCRAPE_ON_START=true

# عدد الصفحات التي يتم قراءتها (المطلوب: أول 10 صفحات)
MAX_PAGES=10

# Advanced Express middleware
CORS_ORIGIN=
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=512kb
NEWS_CACHE_TTL_SECONDS=60

# Optional API keys format:
# API_KEYS=secret-reader:reader:public:user-1,secret-admin:admin:public:admin-1
API_KEYS=

RATE_LIMIT_IP_MAX=300
RATE_LIMIT_TENANT_MAX=500
RATE_LIMIT_USER_MAX=120
RATE_LIMIT_SENSITIVE_MAX=10
RATE_LIMIT_SCRAPE_MAX=3
