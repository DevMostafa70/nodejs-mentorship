PORT=3000
DATABASE_FILE=./data.sqlite

# صفحة "المساعدات" في موقع المتقدمون (حسب وصف مشروع المساق)
BASE_URL=https://www.motqdmon.com/search/label/%D8%A7%D9%84%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A7%D8%AA

# تشغيل scraping تلقائياً عند تشغيل السيرفر
SCRAPE_ON_START=true

# عدد الصفحات التي يتم قراءتها (المطلوب: أول 10 صفحات)
MAX_PAGES=10
